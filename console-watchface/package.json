{
  "name": "console-watchface",
  "author": "Ciaran",
  "version": "1.0.0",
  "keywords": ["pebble-app"],
  "private": true,
  "dependencies": {},
  "pebble": {
    "displayName": "Console",
    "uuid": "22f46065-2fd0-41e1-8f41-19294bef2d1e",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": ["emery"],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "WEATHER_TEMP",
      "WEATHER_ICON",
      "DUBLIN_OFFSET"
    ],
    "resources": {
      "media": [
        {
          "type": "font",
          "name": "SPACE_GROTESK_72",
          "file": "fonts/SpaceGrotesk-SemiBold.ttf",
          "compatibility": "2.7",
          "characterRegex": "[0-9:]"
        },
        {
          "type": "font",
          "name": "SPACE_GROTESK_24",
          "file": "fonts/SpaceGrotesk-SemiBold.ttf",
          "compatibility": "2.7",
          "characterRegex": "[-0-9°C]"
        },
        {
          "type": "font",
          "name": "SPACE_GROTESK_22",
          "file": "fonts/SpaceGrotesk-Medium.ttf",
          "compatibility": "2.7",
          "characterRegex": "[0-9:]"
        },
        {
          "type": "font",
          "name": "SPACE_MONO_18",
          "file": "fonts/SpaceMono-Regular.ttf",
          "compatibility": "2.7",
          "characterRegex": "[0-9A-Z ]"
        },
        {
          "type": "font",
          "name": "SPACE_MONO_14",
          "file": "fonts/SpaceMono-Regular.ttf",
          "compatibility": "2.7",
          "characterRegex": "[A-Z]"
        },
        {
          "type": "font",
          "name": "SPACE_MONO_13",
          "file": "fonts/SpaceMono-Regular.ttf",
          "compatibility": "2.7",
          "characterRegex": "[A-Z]"
        }
      ]
    }
  }
}
