{
  "name": "console-watchface",
  "author": "Ciaran",
  "version": "1.0.0",
  "keywords": ["pebble-app"],
  "private": true,
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "pebble-clay": "^1.0.4"
  },
  "pebble": {
    "displayName": "Homezone",
    "uuid": "22f46065-2fd0-41e1-8f41-19294bef2d1e",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": ["emery"],
    "capabilities": ["configurable", "health"],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "WEATHER_TEMP",
      "WEATHER_ICON",
      "SETTINGS_COMPLICATION",
      "SETTINGS_TZ_OFFSET",
      "SETTINGS_TZ_LABEL",
      "SETTINGS_TEMP_UNIT",
      "SETTINGS_THEME",
      "SETTINGS_ACCENT"
    ],
    "resources": {
      "media": [
        {
          "menuIcon": true,
          "type": "png",
          "name": "IMAGE_MENU_ICON",
          "file": "images/menu_icon.png"
        },
        {
          "type": "font",
          "name": "SPACE_GROTESK_72",
          "file": "fonts/SpaceGrotesk-SemiBold.ttf",
          "compatibility": "2.7",
          "characterRegex": "[0-9:]"
        },
        {
          "type": "font",
          "name": "SPACE_GROTESK_24",
          "file": "fonts/SpaceGrotesk-SemiBold.ttf",
          "compatibility": "2.7",
          "characterRegex": "[-0-9°CF]"
        },
        {
          "type": "font",
          "name": "SPACE_GROTESK_22",
          "file": "fonts/SpaceGrotesk-Medium.ttf",
          "compatibility": "2.7",
          "characterRegex": "[-0-9:%,.K]"
        },
        {
          "type": "font",
          "name": "SPACE_MONO_18",
          "file": "fonts/SpaceMono-Regular.ttf",
          "compatibility": "2.7",
          "characterRegex": "[0-9A-Z ]"
        },
        {
          "type": "font",
          "name": "SPACE_MONO_14",
          "file": "fonts/SpaceMono-Regular.ttf",
          "compatibility": "2.7",
          "characterRegex": "[A-Z0-9 '&./+-]"
        },
        {
          "type": "font",
          "name": "SPACE_MONO_13",
          "file": "fonts/SpaceMono-Regular.ttf",
          "compatibility": "2.7",
          "characterRegex": "[A-Z]"
        }
      ]
    }
  }
}
